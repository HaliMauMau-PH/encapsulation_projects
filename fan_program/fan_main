import time
import tkinter as tk

#=======================================================================
class Fan:
    SLOW = 1
    MEDIUM = 2
    FAST = 3
    
    def __init__(self, speed=SLOW, on=False, radius = 5.0, color="blue"):
        self.__speed = speed
        self.__on = on
        self.__radius = radius
        self.__color = color
        
    def set_speed(self, speed):
        if speed in [Fan.SLOW, Fan.MEDIUM, Fan.FAST]:
            self.__speed = speed
            
    def set_on(self, on): self.__on = on  
    def set_radius(self, radius): self.__radius = radius  
    def set_color(self, color): self.__color = color
        
    def get_speed(self): return self.__speed
    def get_on(self): return self.__on
    def get_radius(self): return self.__radius
    def get_color(self): return self.__color


#=======================================================================
class FanDisplay:
    def __init__(self, root):
        self.root = root
        self.root.title("Smart Fan Control Panel")
        self.root.geometry("450x500")
        self.root.configure(bg="#2c3e50")

        self.my_fan = Fan()
        self.setup_ui()
        self.update_screen()
        
    def setup_ui(self):
            self.screen = tk.Label(self.root, text="", font=("Courier", 14), bg="#34495e", fg="#ecf0f1", height=8, justify=tk.LEFT)
            self.screen.pack(pady=20, padx=20, fill=tk.X)
            
            control_frame = tk.Frame(self.root, bg="#2c3e50")
            control_frame.pack(pady=10)
            
            self.btn_power = tk.Button(control_frame, text="POWER ON", command=self.toggle_power, bg="#e74c3c", fg="white", font=("Arial", 12, "bold"), width=15)
            self.btn_power.grid(row=0, column=0, columnspan=3, pady=10)
            
            tk.Button(control_frame, text="SLOW (1)", command=lambda: self.change_speed(Fan.SLOW), width=10).grid(row=1, column=0, padx=5)
            tk.Button(control_frame, text="MED (2)", command=lambda: self.change_speed(Fan.MEDIUM), width=10).grid(row=1, column=1, padx=5)
            tk.Button(control_frame, text="FAST (3)", command=lambda: self.change_speed(Fan.FAST), width=10).grid(row=1, column=2, padx=5)
            
            settings_frame = tk.Frame(self.root, bg="#2c3e50")
            settings_frame.pack(pady=20)
            
            tk.Label(settings_frame, text="Radius:", bg="#2c3e50", fg="white").grid(row=0, column=0)
            self.radius_var = tk.DoubleVar(value=5.0)
            tk.Entry(settings_frame, textvariable=self.radius_var, width=10).grid(row=0, column=1, padx=10)
            
            tk.Label(settings_frame, text="Color:", bg="#2c3e50", fg="white").grid(row=0, column=2)
            self.color_var = tk.StringVar(value="blue")
            tk.Entry(settings_frame, textvariable=self.color_var, width=10).grid(row=0, column=3, padx=10)
            
            tk.Button(self.root, text="Apply Settings", command=self.apply_settings, bg="#2980b9", fg="white").pack()
            
            
    def update_screen(self):
        pass

    def toggle_power(self):
        print("Power button clicked!")

    def change_speed(self, speed):
        print(f"Speed button {speed} clicked!")

    def apply_settings(self):
        print("Apply Settings clicked!")
        
        
