class Car:
    def __init__(self, year_model, make):
        self.__year_model = year_model
        self.__make = make
        self.__speed = 0
        
    def accelerate(self):
            self.__speed += 5
            
            
    def brake(self):
            self.__speed -= 5
            if self.__speed < 0:
                self.__speed = 0
                
    def get_speed(self):
            return self.__speed
    
def main():
        my_car = Car(2025, "AE86")
            
        for i in range(5):
                my_car.accelerate()
                
        for i in range(5):
                my_car.brake()

if __name__ == "__main__":
        main()
                    
