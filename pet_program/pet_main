import time

class Pet:
    def __init__(self):
        self.__name = ""
        self.__animal_type = ""
        self.__age = 0
        
    def set_name(self, name):
        self.__name = name
            
    def set_animal_type(self, animal_type):
        self.__animal_type = animal_type
            
    def set_age(self, age):
        self.__age = age

    def get_name(self):
        return self.__name
    def get_animal_type(self):
        return self.__animal_type
    def get_age(self):
        return self.__age
    
    def speak(self):
        if self.get_animal_type().lower() == 'dog':
            return "Woof! Bark!"
        elif self.get_animal_type().lower() == 'cat':
            return "Meow! Purrr..."        
        elif self.get_animal_type().lower() == 'bird':
            return "Chirp! tweet..."
        else:
            return "*alien noises*"
        
def main():
        my_pet = Pet()
        
        pet_name = input("Enter your pet's name: ")
        my_pet.set_name(pet_name)
        
        pet_type = input("Enter your pet's animal type (e.g. Dog, Cat): ")
        my_pet.set_animal_type(pet_type)
        
        pet_age = int(input("Enter your pet's age: "))
        my_pet.set_age(pet_age)
        
        
        print("\n⏳ Processing Biometric Data...")
        for i in range(1, 4):
            print("█" * (i * 12) + f" {i*33}%")
            time.sleep(0.5)
        print("█" * 40 + " 100%")
        time.sleep(0.3)
        
        print("\n--- Pet Details ---")
        print("Name:", my_pet.get_name())
        print("Type:", my_pet.get_animal_type())
        print("Age:", my_pet.get_age())
        
        print(f"\nLet's hear from {my_pet.get_name()}:")
        time.sleep(0.5)
        print(my_pet.speak())

if __name__ == "__main__":
    main()        